{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "space_definition.schema.json",
  "title": "Space definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "centaur_principal_id", "centaur_session_id", "tool_allowlist", "budget_refs"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "centaur_principal_id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque Centaur principal identifier."
    },
    "centaur_session_id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque Centaur session identifier."
    },
    "tool_allowlist": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "budget_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
