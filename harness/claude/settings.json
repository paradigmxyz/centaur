{
  "model": "claude-opus-5-5",
  "alwaysThinkingEnabled": true,
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md"
      }
    }
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "/home/agent/workspace",
      "/home/agent/uploads"
    ]
  },
  "includeCoAuthoredBy": false,
  "cleanupPeriodDays": 1,
  "viewMode": "verbose"
}
