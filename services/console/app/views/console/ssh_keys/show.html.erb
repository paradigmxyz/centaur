<% content_for :title, "SSH key · Centaur Console" %>
<%= render "console/page_header", title: @key.name, subtitle: "Your personal SSH key" %>
<div class="max-w-3xl space-y-6">
  <div class="rounded border border-green-700 bg-green-950/20 p-4" role="status">
    <p class="font-semibold">SSH key saved</p>
    <p class="text-sm">Saved <%= @key.updated_at.utc.strftime("%Y-%m-%d %H:%M UTC") %>. Your private key is stored encrypted. You can leave this page.</p>
    <p class="form-hint">This confirms the key was saved; it does not test access to an environment. Register the public key below in your environments.</p>
  </div>
  <section class="form-section">
    <h2 class="form-section-heading">Key details</h2>
    <p class="form-hint mb-4">Provide the destination URL when asking Centaur to connect.</p>
    <dl class="space-y-4 text-sm">
      <div><dt class="form-label">Your key fingerprint</dt><dd class="break-all font-mono text-zinc-300"><%= @key.key_fingerprint %></dd></div>
    </dl>
  </section>
  <section class="form-section">
    <h2 class="form-section-heading">Granted to</h2>
    <p class="form-hint mb-4">Only these principals can use this key. Your Console and DM principals are granted automatically; anything else was granted by an administrator.</p>
    <% if @grants.any? %>
      <ul class="space-y-1 text-sm">
        <% @grants.each do |grant| %>
          <% grantee = grant.grantee %>
          <li class="font-mono text-zinc-300"><%= grant.role ? "Role" : "Principal" %>: <%= grantee.try(:name).presence || grantee.foreign_id.presence || grantee.oid %><% if grant.principal %> <span class="text-zinc-500">(<%= grant.principal.kind %>)</span><% end %></li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-zinc-500">Not granted yet. It is granted to your Console principal when you next use Console, and to your Slack DM once a verified Slack identity is linked.</p>
    <% end %>
  </section>
  <section class="form-section">
    <h2 class="form-section-heading">Register your public key in your environments</h2>
    <p class="form-hint mb-4">Add this public key to each environment's SSH access settings. You can reuse this key for any URL allowed by your administrator. Saving does not register it automatically.</p>
    <label class="form-label" for="ssh-public-key">Public key</label>
    <textarea id="ssh-public-key" class="form-input font-mono" rows="4" readonly spellcheck="false"><%= @key.public_key %></textarea>
    <p class="form-hint">Your private key is stored encrypted and cannot be viewed or downloaded.</p>
  </section>
  <div class="flex flex-wrap gap-3">
    <%= link_to "Edit", edit_console_ssh_key_path, class: "btn-primary" %>
    <%= button_to "Delete", console_ssh_key_path, method: :delete, class: "btn-secondary", form: { data: { turbo_confirm: "Delete this SSH key? Access ends within seconds." } } %>
    <%= link_to "Back to integrations", console_integrations_path, class: "btn-secondary" %>
  </div>
</div>
