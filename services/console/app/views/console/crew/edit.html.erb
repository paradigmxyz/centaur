<% content_for :title, "#{@bot['name']} · Crew" %>
<%= link_to "← Crew", console_crew_index_path, class: "text-sm text-zinc-500 hover:text-zinc-200" %>
<div class="flex flex-wrap items-start justify-between gap-4 mt-6">
  <%= render "console/page_header", title: @bot["name"], subtitle: "#{@bot['id']} · #{@bot['status'].to_s.humanize}#{@bot['paused'] ? ' · Paused' : ''}" %>
  <% if @bot["status"] == "active" %>
    <%= button_to @bot["paused"] ? "Resume bot" : "Pause bot", console_crew_path(@bot["id"]), method: :patch, params: { crew: { paused: !@bot["paused"] } }, class: "btn-secondary" %>
  <% elsif @bot["status"] == "needs_install" %>
    <%= button_to "Retry automatic installation", install_console_crew_path(@bot["id"]), class: "btn-primary", form: { data: { turbo: false } } %>
  <% else %><p class="text-sm text-amber-400">Setup was interrupted. Reconcile the Slack app before retrying.</p><% end %>
</div>
<% if @bot["install_error"].present? %><p class="mb-6 text-sm text-amber-400"><%= @bot["install_error"] %></p><% end %>
<%= render "form", creating: false %>
