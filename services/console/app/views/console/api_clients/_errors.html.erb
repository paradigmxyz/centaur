<% if api_client.errors.any? %>
  <div class="alert-error">
    <p class="font-semibold">API client could not be saved.</p>
    <ul class="mt-2 list-disc pl-5">
      <% api_client.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
