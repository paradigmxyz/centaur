<% content_for :title, "Integrations · Centaur Console" %>

<%= render "console/page_header",
           title: "Integrations",
           subtitle: "Connect your personal accounts so Centaur can act on your behalf." %>

<% if @oauth_apps.empty? %>
  <p class="empty-state">No integrations available yet.</p>
<% else %>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @oauth_apps.each do |app| %>
      <% start_url = "#{public_base_url}/oauth/#{app.slug}/start" %>
      <div class="console-panel flex flex-col gap-3 p-5">
        <div class="flex items-center gap-3">
          <% logo = oauth_provider_logo(app.provider, classes: "size-8 shrink-0") %>
          <% if logo %>
            <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-ink-700 text-zinc-200"><%= logo %></span>
          <% else %>
            <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-ink-700 text-xs font-semibold uppercase tracking-wide text-zinc-300"><%= app.provider.first(2) %></span>
          <% end %>
          <div class="min-w-0">
            <div class="truncate font-mono text-sm font-semibold text-zinc-100" title="<%= app.slug %>"><%= app.slug %></div>
            <div class="text-[11px] uppercase tracking-wide text-zinc-500"><%= app.provider %></div>
          </div>
        </div>
        <% if app.description.present? %>
          <p class="line-clamp-2 text-xs text-zinc-500" title="<%= app.description %>"><%= app.description %></p>
        <% end %>
        <p class="text-xs text-zinc-500"><%= app.always_available? ? "Used automatically whenever you ask the bot." : "Used only in your DMs with the bot." %></p>
        <div class="mt-auto flex items-center justify-between gap-3 pt-1">
          <% credential = @credentials_by_app_id[app.id] %>
          <% if credential %>
            <% needs_reconnect = app.credential_needs_reconnect?(credential) %>
            <a href="<%= start_url %>" class="btn-secondary inline-block">Reconnect</a>
            <span class="flex items-center gap-1.5 text-xs <%= needs_reconnect ? "text-amber-300" : "text-emerald-300" %>">
              <span class="size-1.5 rounded-full <%= needs_reconnect ? "bg-amber-400" : "bg-emerald-400" %>"></span>
              <%= needs_reconnect ? "Needs reconnecting" : "Connected" %>
            </span>
          <% else %>
            <a href="<%= start_url %>" class="btn-primary inline-block">Connect</a>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
  <p class="mt-6 text-xs text-zinc-600">Connecting opens the provider's consent screen. Once you approve, Centaur stores and refreshes the credential automatically.</p>
<% end %>

<% if acting_admin? %>
  <section aria-labelledby="organization-integrations" class="mt-8">
    <header class="console-page-header">
      <div class="console-page-heading">
        <div class="console-page-title-copy">
          <h2 id="organization-integrations" class="page-title">Admin Integrations</h2>
          <div class="page-subtitle">Connections shared by your organization’s agents.</div>
        </div>
      </div>
    </header>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <div class="console-panel flex flex-col gap-3 p-5">
        <div class="flex items-center gap-3">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-ink-700 text-2xl text-zinc-300" aria-hidden="true">🌐</span>
          <div>
            <h3 class="font-mono text-sm font-semibold text-zinc-100">Mercator</h3>
            <div class="text-[11px] uppercase tracking-wide text-zinc-500">mercator</div>
          </div>
        </div>
        <p class="text-xs text-zinc-400">A shared wallet for your agents to discover and pay for external tools and services.</p>
        <div class="mt-auto flex items-center justify-between gap-3 pt-1">
          <% if @mercator_credential %>
            <%= link_to "Manage", console_mercator_path, class: "btn-secondary" %>
            <span class="text-xs <%= @mercator_credential.dead? ? "text-amber-300" : "text-emerald-300" %>"><%= @mercator_credential.dead? ? "Needs reconnecting" : "Connected" %></span>
          <% elsif @mercator_manual_configuration %>
            <%= link_to "Review connection", console_mercator_path, class: "btn-secondary" %>
          <% else %>
            <%= button_to "Connect", connect_console_mercator_path, class: "btn-primary", form: { data: { turbo: false } } %>
          <% end %>
        </div>
      </div>
    </div>
  </section>
<% end %>
