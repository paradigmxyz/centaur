<div class="relative" data-controller="dropdown">
  <button type="button" data-action="dropdown#toggle" class="btn-primary">
    + Add Secret
  </button>
  <div data-dropdown-target="menu" hidden
       class="absolute right-0 z-20 mt-2 w-48 overflow-hidden rounded-lg border border-ink-600 bg-ink-850 shadow-xl">
    <% secret_form_kinds.each_value do |cfg| %>
      <%= link_to cfg[:label],
                  new_polymorphic_path([ :console, cfg[:model].new ]),
                  class: "block px-4 py-2 text-sm text-zinc-300 transition-colors hover:bg-centaur-500/[0.08] hover:text-centaur-300" %>
    <% end %>
  </div>
</div>
