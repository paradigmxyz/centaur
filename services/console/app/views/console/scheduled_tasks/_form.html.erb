<%= form_with model: [ :console, task ],
              class: "space-y-5",
              data: {
                controller: "slack-channel-autocomplete",
                slack_channel_autocomplete_url_value: slack_channel_options_console_scheduled_tasks_path,
                slack_channel_autocomplete_dm_user_id_value: @slack_dm_user_id
              } do |form| %>
  <% if task.errors.any? %>
    <div class="rounded border border-red-500/30 bg-red-500/[0.08] px-4 py-3 text-sm text-red-200">
      <p class="font-semibold">Could not save this task:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <% task.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "mb-2 block text-sm font-medium text-zinc-200" %>
    <%= form.text_field :name,
          required: true,
          maxlength: 100,
          autofocus: !task.persisted?,
          placeholder: "Daily support summary",
          class: "form-input" %>
    <p class="mt-2 text-xs text-zinc-500">A label for finding and managing this task in the console.</p>
  </div>

  <div>
    <%= form.label :prompt, "Agent prompt", class: "mb-2 block text-sm font-medium text-zinc-200" %>
    <%= form.text_area :prompt,
          rows: 12,
          required: true,
          placeholder: "Review open support issues and summarize the most important changes.",
          class: "min-h-64 w-full resize-y rounded-lg border border-ink-600 bg-ink-900 px-4 py-3 text-sm leading-6 text-zinc-100 outline-none focus:border-centaur-500 focus:ring-1 focus:ring-centaur-500" %>
    <p class="mt-2 text-xs text-zinc-500">Each run sends this prompt through one agent turn.</p>
  </div>

  <fieldset>
    <legend class="mb-2 block text-sm font-medium text-zinc-200">Deliver to</legend>
    <% delivery_mode = if task.delivery_channel.to_s.start_with?("U", "W")
         "dm"
       elsif task.delivery_channel.present?
         "channel"
       else
         @slack_dm_user_id.present? ? "dm" : "channel"
       end %>
    <div class="flex flex-wrap gap-4">
      <label class="flex items-center gap-2 text-sm text-zinc-300">
        <%= radio_button_tag "scheduled_task[delivery_mode]",
                             "dm",
                             delivery_mode == "dm",
                             disabled: @slack_dm_user_id.blank?,
                             data: {
                               slack_channel_autocomplete_target: "deliveryMode",
                               action: "slack-channel-autocomplete#deliveryModeChanged"
                             } %>
        <span>Deliver to my DM</span>
      </label>
      <label class="flex items-center gap-2 text-sm text-zinc-300">
        <%= radio_button_tag "scheduled_task[delivery_mode]",
                             "channel",
                             delivery_mode == "channel",
                             data: {
                               slack_channel_autocomplete_target: "deliveryMode",
                               action: "slack-channel-autocomplete#deliveryModeChanged"
                             } %>
        <span>Deliver to a channel</span>
      </label>
    </div>

    <% delivery_channel_picker_id = dom_id(task, :delivery_channel_picker) %>
    <div class="mt-3"
         <%= "hidden" if delivery_mode == "dm" %>
         data-slack-channel-autocomplete-target="channelFields">
      <%= render "console/shared/slack_channel_autocomplete",
                 field: form,
                 attribute: :delivery_channel,
                 picker_id: delivery_channel_picker_id,
                 display_value: delivery_mode == "channel" ? task.delivery_channel.presence : nil %>
      <p class="text-xs text-zinc-500">Public channels are always available. Private channels require both you and the Centaur bot to be members.</p>
    </div>
    <% if @slack_dm_user_id.blank? %>
      <p class="mt-2 text-xs text-zinc-500">Connect your Slack account to deliver to your DM.</p>
    <% end %>
  </fieldset>

  <% cron_schedule = task.schedule_preset == "cron" %>
  <div class="grid gap-5 lg:grid-cols-2" data-controller="schedule-fields">
    <div>
      <%= form.label :schedule_preset, "Schedule", class: "mb-2 block text-sm font-medium text-zinc-200" %>
      <%= form.select :schedule_preset,
            options_for_select(
              ScheduledTask::SCHEDULE_PRESET_LABELS.map { |preset, label| [ label, preset ] } + [ [ "Cron", "cron" ] ],
              task.schedule_preset
            ),
            {},
            class: "form-input",
            data: {
              schedule_fields_target: "preset",
              action: "schedule-fields#update"
            } %>
      <p class="mt-2 text-xs text-zinc-500">All schedules use Pacific Time.</p>
    </div>

    <div data-schedule-fields-target="cron" <%= "hidden" unless cron_schedule %>>
      <%= form.label :cron_expression, "Cron expression", class: "mb-2 block text-sm font-medium text-zinc-200" %>
      <%= form.text_field :cron_expression,
            required: cron_schedule,
            disabled: !cron_schedule,
            placeholder: "0 9 * * 1-5",
            class: "form-input font-mono",
            data: { schedule_fields_target: "expression" } %>
      <p class="mt-2 text-xs text-zinc-500">Cron expressions are evaluated in Pacific Time.</p>
    </div>
  </div>

  <label class="flex items-start gap-3 rounded border border-ink-700 bg-ink-900/50 px-4 py-3">
    <%= form.check_box :enabled, class: "mt-0.5 rounded border-ink-500 bg-ink-900 text-centaur-500" %>
    <span>
      <span class="block text-sm font-medium text-zinc-200">Schedule enabled</span>
      <span class="mt-1 block text-xs text-zinc-500">Disabled tasks remain saved and can still be run manually.</span>
    </span>
  </label>

  <div class="flex flex-wrap items-center gap-3">
    <%= form.submit task.persisted? ? "Save task" : "Create task",
                    class: "btn-primary cursor-pointer disabled:cursor-not-allowed disabled:opacity-50",
                    data: { slack_channel_autocomplete_target: "submit" } %>
    <%= link_to "Cancel", console_scheduled_tasks_path, class: "btn-secondary" %>
  </div>
<% end %>
