<% content_for :title, "Mercator · Centaur Console" %>
<%= link_to "← Integrations", console_integrations_path, class: "console-link mb-4 inline-block text-sm" %>
<%= render "console/page_header", title: "Mercator" %>

<div class="console-panel max-w-2xl space-y-6 p-6">
  <% if @credential %>
    <% needs_reconnect = @credential.dead? %>
    <div class="flex items-center justify-between gap-4">
      <h2 class="text-base font-semibold text-zinc-100">Shared wallet</h2>
      <span class="text-sm <%= needs_reconnect ? "text-amber-300" : "text-emerald-300" %>"><%= needs_reconnect ? "Reconnect required" : "Connected" %></span>
    </div>
    <a href="https://explore.tempo.xyz/address/<%= ERB::Util.url_encode(@credential.provider_subject.to_s) %>" class="console-link inline-block font-mono text-sm" title="<%= @credential.provider_subject %>" target="_blank" rel="noopener noreferrer"><%= @credential.provider_subject.to_s.first(6) %>…<%= @credential.provider_subject.to_s.last(4) %> ↗</a>
    <div class="flex flex-wrap items-center gap-3">
      <%= link_to "Manage wallet ↗", "https://mercator.sh/account", class: "btn-secondary", target: "_blank", rel: "noopener noreferrer" %>
      <%= link_to "Claim 100 MACH through Slack", @claim_url, class: "btn-primary", target: "_blank", rel: "noopener noreferrer" if @claim_url %>
    </div>
    <% if needs_reconnect %>
      <%= button_to "Reconnect", connect_console_mercator_path, class: "btn-secondary", form: { data: { turbo: false } } %>
    <% end %>
    <details class="text-xs text-zinc-400">
      <summary class="cursor-pointer">Connection settings</summary>
      <div class="mt-3 flex flex-wrap gap-3">
        <% unless needs_reconnect %>
          <%= button_to "Reconnect", connect_console_mercator_path, class: "btn-secondary", form: { data: { turbo: false } } %>
        <% end %>
        <%= link_to "Agent access", console_secret_path("static", @credential.static_secret.oid, anchor: "roles"), class: "btn-secondary" if @credential.static_secret %>
      </div>
    </details>
  <% elsif @manual_credentials %>
    <h2 class="text-base font-semibold text-zinc-100">Existing Mercator configuration</h2>
    <p class="text-sm text-zinc-400">A manually configured credential already exists. Review it before creating a shared connection so your existing wallet and agent access are preserved.</p>
    <%= link_to "Review credentials", console_credentials_path, class: "btn-secondary" %>
  <% else %>
    <h2 class="text-base font-semibold text-zinc-100">Connect your organization’s wallet</h2>
    <p class="text-sm leading-relaxed text-zinc-400">Mercator lets your agents discover and pay for external tools and services from one shared balance.</p>
    <ol class="list-decimal space-y-3 pl-5 text-sm text-zinc-300">
      <li>Create a Tempo Wallet or use an existing wallet in Mercator.</li>
      <li>Approve the spending limits for your organization’s agents.</li>
      <li>Return here. Centaur connects the credentials automatically.</li>
    </ol>
    <p class="text-xs leading-relaxed text-zinc-500">Choose a wallet your organization controls. After connecting, select which existing roles can use it.</p>
    <%= button_to "Connect", connect_console_mercator_path, class: "btn-primary", form: { data: { turbo: false } } %>
    <p class="text-xs text-zinc-500">You’ll continue to Mercator to set up your wallet and approve access.</p>
  <% end %>
</div>
