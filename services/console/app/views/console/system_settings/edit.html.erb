<% content_for :title, "Settings · Centaur Console" %>
<% checkbox_class = "mt-1 h-4 w-4 rounded border-ink-500 bg-ink-800 text-centaur-500 focus:ring-centaur-500" %>

<%= render "console/control_tabs" %>

<%= render "console/page_header",
           title: "Settings",
           subtitle: "Deployment-wide defaults for new control-plane records." %>

<%= form_with model: @system_setting,
              url: console_system_settings_path,
              method: :patch,
              data: { turbo: false },
              class: "space-y-6" do |form| %>
  <% if @system_setting.errors.any? %>
    <div class="alert-error">
      <div class="font-semibold">Settings could not be saved.</div>
      <ul class="mt-2 list-disc pl-5">
        <% @system_setting.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="form-section">
    <h2 class="form-section-heading">Organization instructions</h2>
    <p class="mb-4 text-sm text-zinc-500">
      Deployment-wide behavior guidance appended to the code-managed system prompt. It cannot grant tools or change security policy.
      Published changes apply on an agent's next turn without a deployment.
    </p>
    <%= form.text_area :organization_instructions_draft,
                       rows: 14,
                       maxlength: 32_000,
                       class: "form-input font-mono text-sm",
                       placeholder: "Describe when agents should consult canonical internal sources…" %>
    <div class="mt-3 flex flex-wrap items-center gap-3">
      <%= form.submit "Save draft", class: "btn-secondary" %>
      <%= form.button "Publish to agents",
                      name: "publish_organization_instructions",
                      value: "1",
                      class: "btn-primary" %>
      <% if (published = @system_setting.published_organization_instruction_version) %>
        <span class="text-xs text-zinc-500">
          Published revision <%= published.id %> by <%= published.published_by.email %>
          <%= time_ago_in_words(published.created_at) %> ago
        </span>
      <% else %>
        <span class="text-xs text-zinc-500">No organization instructions are published.</span>
      <% end %>
    </div>
    <details class="mt-4 rounded border border-ink-700 bg-ink-900/60 p-4">
      <summary class="cursor-pointer text-sm font-medium text-zinc-200">Preview appended instructions</summary>
      <pre class="mt-3 whitespace-pre-wrap text-xs text-zinc-400">[Organization instructions]
<%= @system_setting.organization_instructions_draft %></pre>
    </details>
  </section>

  <section class="form-section">
    <h2 class="form-section-heading">Default Sandbox Capabilities</h2>
    <div class="grid gap-5 md:grid-cols-3">
      <label class="block">
        <span class="form-label">Repo cache</span>
        <%= form.select :default_sandbox_repo_cache,
                        options_for_select([
                          [ "None", "none" ],
                          [ "Public", "public" ],
                          [ "All", "all" ]
                        ], @system_setting.default_sandbox_repo_cache),
                        {},
                        class: "form-input" %>
        <span class="form-hint">Initial repo-cache access for new principals.</span>
      </label>

      <label class="flex items-start gap-3 rounded border border-ink-700 bg-ink-850/60 p-4">
        <%= form.check_box :default_sandbox_observability_enabled, class: checkbox_class %>
        <span>
          <span class="block text-sm font-medium text-zinc-100">Observability</span>
          <span class="block text-xs text-zinc-500">Allow new sandboxes to reach logs and metrics surfaces.</span>
        </span>
      </label>

      <label class="flex items-start gap-3 rounded border border-ink-700 bg-ink-850/60 p-4">
        <%= form.check_box :default_sandbox_sessions_read_enabled, class: checkbox_class %>
        <span>
          <span class="block text-sm font-medium text-zinc-100">Read sessions</span>
          <span class="block text-xs text-zinc-500">Allow new sandbox API tokens to read sessions and session events.</span>
        </span>
      </label>

      <label class="flex items-start gap-3 rounded border border-ink-700 bg-ink-850/60 p-4">
        <%= form.check_box :default_sandbox_workflows_read_enabled, class: checkbox_class %>
        <span>
          <span class="block text-sm font-medium text-zinc-100">Read workflows</span>
          <span class="block text-xs text-zinc-500">Allow new sandbox API tokens to list workflow schedules and inspect runs.</span>
        </span>
      </label>

      <label class="flex items-start gap-3 rounded border border-ink-700 bg-ink-850/60 p-4">
        <%= form.check_box :default_sandbox_workflows_write_enabled, class: checkbox_class %>
        <span>
          <span class="block text-sm font-medium text-zinc-100">Write workflows</span>
          <span class="block text-xs text-zinc-500">Allow new sandbox API tokens to create and cancel workflow runs.</span>
        </span>
      </label>
    </div>
  </section>

  <section class="form-section">
    <h2 class="form-section-heading">Default Roles</h2>
    <p class="mb-4 text-sm text-zinc-500">
      New principals with no preassigned roles receive the selected roles. Existing principals are unchanged.
    </p>

    <%= hidden_field_tag "system_setting[default_role_ids][]", "" %>
    <% if @roles.any? %>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          <fieldset class="rounded border border-ink-700 bg-ink-850/60 p-4">
            <div class="space-y-3">
              <% @roles.each do |role| %>
                <% role_label = role.name.presence || role.foreign_id.presence || role.oid %>
                <label class="flex items-start gap-3">
                  <%= check_box_tag "system_setting[default_role_ids][]",
                                    role.id,
                                    role.assign_by_default?,
                                    id: "system_setting_default_role_ids_#{role.id}",
                                    class: checkbox_class %>
                  <span>
                    <span class="block text-sm font-medium text-zinc-100"><%= role_label %></span>
                    <span class="block text-xs text-zinc-500"><%= role.foreign_id.presence || role.oid %></span>
                  </span>
                </label>
              <% end %>
            </div>
          </fieldset>
      </div>
    <% else %>
      <p class="text-sm text-zinc-500">Create a role before configuring default role assignments.</p>
    <% end %>
  </section>

  <div class="flex items-center gap-3">
    <%= form.submit "Save settings", class: "btn-primary" %>
    <a href="<%= console_principals_path %>" class="btn-secondary">Cancel</a>
  </div>
<% end %>

<% if @organization_instruction_versions.any? %>
  <section class="form-section mt-6">
    <h2 class="form-section-heading">Published history</h2>
    <div class="space-y-3">
      <% @organization_instruction_versions.each do |version| %>
        <div class="rounded border border-ink-700 bg-ink-850/60 p-4">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="text-sm text-zinc-300">
              Revision <%= version.id %> · <%= version.published_by.email %> · <%= version.created_at.to_fs(:long) %>
            </div>
            <%= button_to "Restore and publish",
                          console_restore_organization_instruction_version_path(version),
                          method: :post,
                          class: "btn-secondary" %>
          </div>
          <pre class="mt-3 max-h-40 overflow-auto whitespace-pre-wrap text-xs text-zinc-500"><%= version.content %></pre>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
