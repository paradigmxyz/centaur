<%= form_with model: [ :console, workflow ],
              class: "space-y-5",
              data: {
                controller: "slack-channel-autocomplete",
                slack_channel_autocomplete_url_value: slack_channel_options_console_authored_workflows_path
              } do |form| %>
  <% if workflow.errors.any? %>
    <div class="rounded border border-red-500/30 bg-red-500/[0.08] px-4 py-3 text-sm text-red-200">
      <p class="font-semibold">Could not save this workflow:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <% workflow.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "mb-2 block text-sm font-medium text-zinc-200" %>
    <%= form.text_field :name,
          required: true,
          maxlength: 100,
          autofocus: !workflow.persisted?,
          placeholder: "Daily support summary",
          class: "form-input" %>
    <p class="mt-2 text-xs text-zinc-500">A label for finding and managing this workflow in the console.</p>
  </div>

  <div>
    <%= form.label :prompt, "Agent prompt", class: "mb-2 block text-sm font-medium text-zinc-200" %>
    <%= form.text_area :prompt,
          rows: 12,
          required: true,
          placeholder: "Review open support issues and summarize the most important changes.",
          class: "min-h-64 w-full resize-y rounded-lg border border-ink-600 bg-ink-900 px-4 py-3 text-sm leading-6 text-zinc-100 outline-none focus:border-centaur-500 focus:ring-1 focus:ring-centaur-500" %>
    <p class="mt-2 text-xs text-zinc-500">Each run sends this prompt through one agent turn.</p>
  </div>

  <div class="grid gap-5 lg:grid-cols-2">
    <div>
      <%= form.label :principal_oid, "Run as", class: "mb-2 block text-sm font-medium text-zinc-200" %>
      <% principal_options = [ [ "Author: #{workflow.author&.email || current_user.email}", "" ] ] +
           @principals.map { |principal| [ principal.name.presence || principal.foreign_id, principal.oid ] } %>
      <%= form.select :principal_oid,
            options_for_select(principal_options, workflow.principal&.oid),
            {},
            class: "form-input" %>
      <p class="mt-2 text-xs text-zinc-500">Author uses your Console principal and its grants. Or select a defined principal.</p>
    </div>

    <div>
      <% delivery_channel_picker_id = dom_id(workflow, :delivery_channel_picker) %>
      <%= form.label :delivery_channel,
                     "Deliver to",
                     for: delivery_channel_picker_id,
                     class: "mb-2 block text-sm font-medium text-zinc-200" %>
      <%= render "console/shared/slack_channel_autocomplete",
                 field: form,
                 attribute: :delivery_channel,
                 picker_id: delivery_channel_picker_id %>
      <p class="text-xs text-zinc-500">Search Slack channels or enter the channel ID that receives the final agent response.</p>
    </div>
  </div>

  <% cron_schedule = workflow.schedule_preset == "cron" %>
  <div class="grid gap-5 lg:grid-cols-2" data-controller="schedule-fields">
    <div>
      <%= form.label :schedule_preset, "Schedule", class: "mb-2 block text-sm font-medium text-zinc-200" %>
      <%= form.select :schedule_preset,
            options_for_select([
              [ "Hourly", "hourly" ],
              [ "Daily at 9:00 PT", "daily" ],
              [ "Weekdays at 9:00 PT", "weekdays" ],
              [ "Cron", "cron" ]
            ], workflow.schedule_preset),
            {},
            class: "form-input",
            data: {
              schedule_fields_target: "preset",
              action: "schedule-fields#update"
            } %>
      <p class="mt-2 text-xs text-zinc-500">All schedules use Pacific Time.</p>
    </div>

    <div data-schedule-fields-target="cron" <%= "hidden" unless cron_schedule %>>
      <%= form.label :cron_expression, "Cron expression", class: "mb-2 block text-sm font-medium text-zinc-200" %>
      <%= form.text_field :cron_expression,
            required: cron_schedule,
            disabled: !cron_schedule,
            placeholder: "0 9 * * 1-5",
            class: "form-input font-mono",
            data: { schedule_fields_target: "expression" } %>
      <p class="mt-2 text-xs text-zinc-500">Cron expressions are evaluated in Pacific Time.</p>
    </div>
  </div>

  <label class="flex items-start gap-3 rounded border border-ink-700 bg-ink-900/50 px-4 py-3">
    <%= form.check_box :enabled, class: "mt-0.5 rounded border-ink-500 bg-ink-900 text-centaur-500" %>
    <span>
      <span class="block text-sm font-medium text-zinc-200">Schedule enabled</span>
      <span class="mt-1 block text-xs text-zinc-500">Disabled workflows remain saved and can still be run manually.</span>
    </span>
  </label>

  <div class="flex flex-wrap items-center gap-3">
    <%= form.submit workflow.persisted? ? "Save workflow" : "Create workflow",
                    class: "btn-primary cursor-pointer disabled:cursor-not-allowed disabled:opacity-50",
                    data: { slack_channel_autocomplete_target: "submit" } %>
    <%= link_to "Cancel", console_workflows_path, class: "btn-secondary" %>
  </div>
<% end %>
