<% content_for :title, "Secrets · Centaur Console" %>

<%= render "control_tabs" %>

<%= render "console/page_header",
           title: "Secrets",
           subtitle: "#{pluralize(@total_secrets, "secret")} total.",
           actions: render("console/add_secret_dropdown") %>

<%= form_with url: console_secrets_path, method: :get, class: "mb-3 flex flex-wrap items-center gap-2" do %>
  <div class="relative w-full max-w-md">
    <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-zinc-500">
      <%= console_icon("magnifying-glass", classes: "size-4") %>
    </span>
    <%= search_field_tag :q,
                         @search_query,
                         placeholder: "Search secret names",
                         aria: { label: "Search secrets by name" },
                         class: "form-input py-2 pl-9" %>
  </div>
  <%= select_tag :type,
                 options_for_select([[ "All types", "" ]] + secret_kind_options, @selected_secret_type),
                 aria: { label: "Filter secrets by type" },
                 class: "form-input w-auto py-2" %>
  <%= submit_tag "Filter", class: "btn-secondary py-2" %>
  <% if @search_query.present? || @selected_secret_type.present? %>
    <%= link_to "Clear", console_secrets_path, class: "px-2 py-2 text-sm text-zinc-500 hover:text-centaur-300" %>
  <% end %>
<% end %>

<form action="<%= console_bulk_update_secrets_path %>" method="post"
      data-turbo="false" data-controller="bulk-selection">
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  <%= hidden_field_tag :_method, "patch" %>
  <%= hidden_field_tag :q, @search_query if @search_query.present? %>
  <%= hidden_field_tag :type, @selected_secret_type if @selected_secret_type.present? %>
  <%= hidden_field_tag :page, @page if @page > 1 %>
  <div class="mb-3 flex flex-wrap items-center gap-2" hidden data-bulk-selection-target="toolbar">
    <span class="mr-1 text-xs text-zinc-500" data-bulk-selection-target="count">0 selected</span>
    <%= select_tag :operation,
                   options_for_select([[ "Bulk edit", "" ], [ "Enable selected", "enable" ], [ "Disable selected", "disable" ]]),
                   aria: { label: "Bulk action" },
                   class: "form-input w-auto py-2",
                   data: { bulk_selection_target: "operation", action: "change->bulk-selection#update" } %>
    <%= submit_tag "Apply", disabled: true,
          class: "btn-secondary py-2 disabled:cursor-not-allowed disabled:opacity-40",
          data: { bulk_selection_target: "submit" } %>
  </div>

<div class="console-panel">
  <table class="console-table console-table-fixed">
    <colgroup>
      <col class="w-12">
      <col class="w-[31%]">
      <col class="w-[17%]">
      <col class="w-[22%]">
      <col class="w-[15%]">
      <col class="w-[15%]">
    </colgroup>
    <thead class="console-table-head">
      <tr>
        <th class="px-5 py-2.5 font-medium">
          <input type="checkbox" aria-label="Select all secrets on this page"
                 data-bulk-selection-target="all" data-action="change->bulk-selection#toggleAll">
        </th>
        <th class="px-5 py-2.5 font-medium">Name</th>
        <th class="px-5 py-2.5 font-medium">Type</th>
        <th class="px-5 py-2.5 font-medium">Source</th>
        <th class="px-5 py-2.5 font-medium">Status</th>
        <th class="px-5 py-2.5 font-medium">Created</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-ink-700">
      <% if @secrets.empty? %>
        <tr>
          <td colspan="6" class="px-5 py-10 text-center text-zinc-600">
            <%= (@search_query.present? || @selected_secret_type.present?) ? "No secrets match these filters." : "No secrets yet." %>
          </td>
        </tr>
      <% end %>
      <% @secrets.each do |kind, secret| %>
        <% display_name = secret.name.presence || "unnamed" %>
        <tr id="<%= dom_id(secret, kind) %>" class="console-row-hover">
          <td class="px-5 py-2">
            <%= check_box_tag "secret_refs[]", "#{kind}:#{secret.oid}", false,
                  aria: { label: "Select #{display_name} (#{secret_kind_label(kind)}, #{secret.oid})" },
                  data: { bulk_selection_target: "item", action: "change->bulk-selection#update" } %>
          </td>
          <td class="min-w-0 overflow-hidden px-5 py-2 text-zinc-100">
            <div class="flex min-w-0 items-center gap-2">
              <%= link_to truncate_middle(display_name, max: 64),
                          console_secret_path(kind, secret.oid),
                          class: "console-link console-cell-truncate #{'text-zinc-600' if secret.name.blank?}",
                          title: display_name %>
              <% if (credential = managed_credential(secret)) %>
                <span class="inline-flex shrink-0 items-center rounded bg-centaur-500/10 px-1.5 py-0.5 text-[11px] text-centaur-300 ring-1 ring-centaur-500/30"
                      title="Managed by the <%= credential.oauth_app&.slug %> OAuth integration">managed</span>
              <% end %>
            </div>
          </td>
          <td class="min-w-0 overflow-hidden px-5 py-2 whitespace-nowrap">
            <span class="resource-badge console-cell-inline-truncate"><%= secret_kind_label(kind) %></span>
          </td>
          <td class="min-w-0 overflow-hidden px-5 py-2">
            <% source_types = secret_source_types(secret) %>
            <% if source_types.any? %>
              <div class="flex min-w-0 flex-wrap gap-1">
                <% source_types.each do |source_type| %>
                  <span class="role-pill console-cell-inline-truncate"><%= source_type %></span>
                <% end %>
              </div>
            <% else %>
              <span class="text-zinc-600">—</span>
            <% end %>
          </td>
          <td class="overflow-hidden px-5 py-2 whitespace-nowrap text-xs">
            <%= render "console/secret_status_badge", secret: secret %>
          </td>
          <td class="overflow-hidden px-5 py-2 whitespace-nowrap text-xs text-zinc-500">
            <span class="console-cell-truncate"><%= local_time(secret.created_at, relative: true, format: :compact) %></span>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= render "console/pagination",
             page: @page,
             total_pages: @total_pages,
             total_count: @total_count,
             unit: "secret" %>
</div>
</form>
