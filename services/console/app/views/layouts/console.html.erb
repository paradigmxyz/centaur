<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title><%= content_for(:title) || "Centaur Console" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">
    <%= csrf_meta_tags %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <meta name="theme-color" content="#050506">
    <link rel="icon" href="/icon-dark.svg" type="image/svg+xml" data-console-favicon>
    <link rel="apple-touch-icon" href="/pwa-icon-192.png">
    <script>
      (() => {
        const storageKey = "centaur-console-theme";
        const storageSourceKey = "centaur-console-theme-source";
        const validTheme = (theme) => theme === "light" || theme === "dark";
        const systemTheme = () => {
          if (window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches) {
            return "light";
          }
          return "dark";
        };
        const storedTheme = () => {
          try {
            const theme = localStorage.getItem(storageKey);
            const source = localStorage.getItem(storageSourceKey);
            return source === "manual" && validTheme(theme) ? theme : null;
          } catch (_error) {
            return null;
          }
        };
        const preference = () => storedTheme() || "system";
        const resolveTheme = () => storedTheme() || systemTheme();
        const applyTheme = (theme) => {
          const nextTheme = validTheme(theme) ? theme : systemTheme();
          document.documentElement.dataset.consoleTheme = nextTheme;

          const favicon = document.querySelector("[data-console-favicon]");
          if (favicon) {
            favicon.setAttribute("href", nextTheme === "light" ? "/icon-light.svg" : "/icon-dark.svg");
          }

          return nextTheme;
        };

        window.ConsoleTheme = {
          apply: applyTheme,
          persist: (theme) => {
            if (theme === "system") {
              try {
                localStorage.removeItem(storageKey);
                localStorage.removeItem(storageSourceKey);
              } catch (_error) {
                // Theme still follows the system for this page load when storage is unavailable.
              }
              return applyTheme(systemTheme());
            }

            const nextTheme = applyTheme(theme);
            try {
              localStorage.setItem(storageKey, nextTheme);
              localStorage.setItem(storageSourceKey, "manual");
            } catch (_error) {
              // Theme still applies for this page load when storage is unavailable.
            }
            return nextTheme;
          },
          preference: preference,
          resolve: resolveTheme
        };

        applyTheme(resolveTheme());

        if (window.matchMedia) {
          const mediaQuery = window.matchMedia("(prefers-color-scheme: light)");
          const syncSystemTheme = () => {
            if (!storedTheme()) applyTheme(resolveTheme());
          };

          if (typeof mediaQuery.addEventListener === "function") {
            mediaQuery.addEventListener("change", syncSystemTheme);
          } else if (typeof mediaQuery.addListener === "function") {
            mediaQuery.addListener(syncSystemTheme);
          }
        }
      })();
    </script>

    <%# Tailwind is compiled by the standalone binary into app/assets/builds/tailwind.css.
        See config/tailwind.config.js for the centaur/ink palette and radii overrides. %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

    <style>
      ::selection { background: #28c26a; color: #050506; }
      html[data-console-theme="dark"] { color-scheme: dark; }
      html[data-console-theme="light"] { color-scheme: light; }
      .glow { filter: drop-shadow(0 0 14px rgba(40,194,106,0.45)); }
      *::-webkit-scrollbar { width: 10px; height: 10px; }
      *::-webkit-scrollbar-track { background: #0b0b0d; }
      *::-webkit-scrollbar-thumb { background: #33333a; border-radius: 1px; }
      *::-webkit-scrollbar-thumb:hover { background: #28c26a; }

      .console-shell {
        display: flex;
        height: 100%;
        overflow: hidden;
        background: #050506;
      }

      /* While descoped, the body becomes a column: banner on top, shell
         filling the rest. Scoped so the normal layout is untouched. */
      .console-descoped {
        display: flex;
        flex-direction: column;
      }

      .console-descoped .console-shell {
        flex: 1 1 auto;
        min-height: 0;
        height: auto;
      }

      .console-descope-banner {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        padding: 0.5rem 1rem;
        font-size: 0.75rem;
        font-weight: 700;
        color: #1c1205;
        background: #f59e0b;
      }

      .console-descope-restore {
        cursor: pointer;
        border-radius: 0.25rem;
        border: 1px solid #1c1205;
        padding: 0.125rem 0.625rem;
        font-weight: 700;
        color: #fbbf24;
        background: #1c1205;
        transition: opacity 120ms ease;
      }

      .console-descope-restore:hover {
        opacity: 0.85;
      }

      .console-sidebar {
        width: 18rem;
        flex: 0 0 auto;
        display: flex;
        min-height: 0;
        flex-direction: column;
        border-right: 1px solid rgba(255, 255, 255, 0.07);
        background: #070708;
        transition: width 160ms ease;
      }

      .console-sidebar-top {
        display: flex;
        height: 3.5rem;
        align-items: center;
        gap: 0.75rem;
        padding: 0 1.5rem;
      }

      .console-brand {
        display: flex;
        min-width: 0;
        flex: 1;
        align-items: center;
        color: #f4f4f5;
      }

      .console-brand img {
        height: 1.75rem;
        width: auto;
      }

      .console-brand-glyph {
        display: none;
        height: 2rem;
        width: 2rem;
        place-items: center;
        border-radius: 0.5rem;
      }

      .console-brand-glyph img {
        height: 1.75rem;
        width: 1.75rem;
        object-fit: contain;
      }

      .console-sidebar-scroll {
        min-height: 0;
        flex: 1;
        overflow-y: auto;
        padding: 0.25rem 0.75rem 1rem;
      }

      .console-nav-list {
        display: grid;
        gap: 0.125rem;
        margin-bottom: 0.125rem;
      }

      .console-nav-link {
        display: flex;
        min-width: 0;
        height: 2.35rem;
        align-items: center;
        gap: 0.625rem;
        border-radius: 0.875rem;
        padding: 0 0.875rem;
        color: #a1a1aa;
        text-decoration: none;
        transition: background 120ms ease, color 120ms ease;
      }

      .console-nav-link:hover {
        background: rgba(255, 255, 255, 0.045);
        color: #f4f4f5;
      }

      .console-nav-link-active {
        background: rgba(255, 255, 255, 0.07);
        color: #3ace79;
      }

      .console-nav-icon {
        display: grid;
        width: 1rem;
        flex: 0 0 auto;
        place-items: center;
        color: currentColor;
      }

      .console-nav-label {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 0.875rem;
        font-weight: 500;
      }

      /* Keep stacked group tabs on the same 0.125rem rhythm as the nav rows above them. */
      .console-thread-group + .console-thread-group {
        margin-top: 0.125rem;
      }

      .console-thread-group-title {
        display: flex;
        height: 2.35rem;
        align-items: center;
        gap: 0.625rem;
        border-radius: 0.875rem;
        padding: 0 0.875rem;
        color: #a1a1aa;
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        transition: background 120ms ease, color 120ms ease;
      }

      .console-thread-group-title:hover {
        background: rgba(255, 255, 255, 0.045);
        color: #f4f4f5;
      }

      .console-thread-group-title-active {
        background: rgba(255, 255, 255, 0.07);
        color: #3ace79;
      }

      .console-sidebar-account {
        position: relative;
        border-top: 1px solid rgba(255, 255, 255, 0.07);
      }

      .console-account-button {
        display: flex;
        height: 3.625rem;
        min-width: 0;
        width: 100%;
        cursor: pointer;
        align-items: center;
        gap: 0.625rem;
        padding: 0 1.5rem;
        text-align: left;
        transition: background 120ms ease, color 120ms ease;
      }

      .console-account-button:hover,
      .console-account-button[aria-expanded="true"] {
        background: rgba(255, 255, 255, 0.045);
      }

      .console-user-avatar {
        display: grid;
        height: 1.75rem;
        width: 1.75rem;
        flex: 0 0 auto;
        place-items: center;
        border-radius: 999px;
        background: rgba(40, 194, 106, 0.16);
        color: #93e7b7;
        font-size: 0.75rem;
        font-weight: 700;
      }

      .console-account-email {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: #71717a;
        font-size: 0.75rem;
      }

      .console-account-menu {
        position: absolute;
        right: 0.75rem;
        bottom: 4.125rem;
        left: 0.75rem;
        z-index: 30;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.11);
        border-radius: 0.875rem;
        background: #101012;
        padding: 0.5rem;
        box-shadow: 0 18px 45px rgba(0, 0, 0, 0.4);
      }

      .console-account-menu[hidden] {
        display: none;
      }

      .console-account-menu-line {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        padding: 0.5rem 0.625rem;
        color: #8b8b94;
        font-size: 0.75rem;
      }

      .console-account-menu-muted {
        color: #5f6068;
      }

      .console-account-menu-separator {
        height: 1px;
        margin: 0.375rem 0.25rem;
        background: rgba(255, 255, 255, 0.08);
      }

      .console-account-menu form {
        margin: 0;
      }

      .console-account-menu-button,
      .console-signout-button {
        display: flex;
        height: 2.25rem;
        width: 100%;
        cursor: pointer;
        align-items: center;
        justify-content: flex-start;
        gap: 0.5rem;
        border-radius: 0.625rem;
        padding: 0 0.625rem;
        color: #a1a1aa;
        font: inherit;
        font-size: 0.875rem;
        font-weight: 500;
        line-height: 1.25rem;
        transition: background 120ms ease, color 120ms ease;
      }

      .console-account-menu-button:hover,
      .console-signout-button:hover {
        background: rgba(255, 255, 255, 0.055);
        color: #f4f4f5;
      }

      /* The install item is hidden until beforeinstallprompt fires; the
         explicit rule is needed because display: flex above would otherwise
         override the hidden attribute. */
      .console-account-menu-button[hidden] {
        display: none;
      }

      .console-main {
        display: flex;
        height: 100%;
        min-width: 0;
        min-height: 0;
        flex: 1;
        flex-direction: column;
        overflow-y: auto;
      }

      .console-main-page {
        width: 100%;
        max-width: 80rem;
        margin: 0 auto;
        padding: 1.35rem 2rem 2.5rem;
      }

      .console-markdown {
        min-width: 0;
      }

      /* markdown_table interpolates Tailwind border classes inside a Ruby
         string, so the compiled build can drop them and the borders fall back
         to currentColor. Scope the real theme colors here instead. */
      .console-markdown table th {
        border-bottom: 1px solid rgba(255, 255, 255, 0.14);
      }

      .console-markdown table td {
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      }

      .console-markdown-link {
        overflow-wrap: anywhere;
        word-break: normal;
      }

      .console-control-tabs {
        display: flex;
        gap: 0.25rem;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        /* Too many tabs to fit a phone width: scroll them horizontally rather
           than clipping the trailing ones off the edge. */
        overflow-x: auto;
        scrollbar-width: none;
      }

      .console-control-tabs::-webkit-scrollbar {
        display: none;
      }

      .console-control-tab {
        margin-bottom: -1px;
        flex: 0 0 auto;
        padding: 0.625rem 0.75rem;
        border-bottom: 1px solid transparent;
        color: #a1a1aa;
        font-size: 0.875rem;
        font-weight: 500;
        white-space: nowrap;
        text-decoration: none;
        transition: border-color 120ms ease, color 120ms ease;
      }

      .console-control-tab:hover {
        color: #f4f4f5;
      }

      .console-control-tab-active {
        border-color: #28c26a;
        color: #3ace79;
      }

      .console-run-row {
        background: rgba(11, 11, 13, 0.45);
        color: #71717a;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.025);
      }

      .console-run-status {
        color: #d4d4d8;
      }

      .console-run-id {
        color: #52525b;
      }

      html[data-console-theme="light"] ::selection {
        background: rgba(40, 194, 106, 0.22);
        color: #1f2428;
      }

      html[data-console-theme="light"] *::-webkit-scrollbar-track {
        background: #f3f3ef;
      }

      html[data-console-theme="light"] *::-webkit-scrollbar-thumb {
        background: #c9cbc5;
      }

      html[data-console-theme="light"] *::-webkit-scrollbar-thumb:hover {
        background: #28a65d;
      }

      html[data-console-theme="light"] body,
      html[data-console-theme="light"] .console-shell,
      html[data-console-theme="light"] .console-main,
      html[data-console-theme="light"] .console-main-page {
        background: #f6f6f2;
        color: #303438;
      }

      html[data-console-theme="light"] .console-sidebar {
        border-right-color: #deded7;
        background: #fbfbf8;
      }

      /* Amber notice boxes keep their translucent amber-on-dark look in dark
         mode, but that washes out on the light background; match the solid
         descope-banner treatment instead. */
      html[data-console-theme="light"] .console-amber-note {
        background: #f59e0b;
        border-color: #b45309;
        color: #1c1205;
        font-weight: 600;
      }

      html[data-console-theme="light"] .console-sidebar-account {
        border-top-color: #deded7;
      }

      html[data-console-theme="light"] .console-brand {
        color: #24272b;
      }

      html[data-console-theme="light"] .console-brand-lockup img,
      html[data-console-theme="light"] .console-brand-glyph img {
        filter: invert(1) drop-shadow(0 0 14px rgba(40, 194, 106, 0.14));
      }

      html[data-console-theme="light"] .console-nav-link,
      html[data-console-theme="light"] .console-thread-group-title,
      html[data-console-theme="light"] .console-account-menu-button,
      html[data-console-theme="light"] .console-signout-button {
        color: #5f656c;
      }

      html[data-console-theme="light"] .console-nav-link:hover,
      html[data-console-theme="light"] .console-thread-group-title:hover,
      html[data-console-theme="light"] .console-account-button:hover,
      html[data-console-theme="light"] .console-account-button[aria-expanded="true"],
      html[data-console-theme="light"] .console-account-menu-button:hover,
      html[data-console-theme="light"] .console-signout-button:hover {
        background: #edede8;
        color: #24272b;
      }

      html[data-console-theme="light"] .console-nav-link-active,
      html[data-console-theme="light"] .console-thread-group-title-active {
        background: #e7eee8;
        color: #168f4a;
      }

      html[data-console-theme="light"] .console-account-email,
      html[data-console-theme="light"] .console-page-meta {
        color: #7a7f86;
      }

      html[data-console-theme="light"] .console-markdown table th {
        border-bottom-color: #d3d3cb;
      }

      html[data-console-theme="light"] .console-markdown table td {
        border-bottom-color: #e5e5de;
      }

      html[data-console-theme="light"] .console-user-avatar {
        background: #dff2e7;
        color: #12733f;
      }

      html[data-console-theme="light"] .console-account-menu {
        border-color: #d8d8d0;
        background: #ffffff;
        box-shadow: 0 18px 45px rgba(31, 36, 40, 0.12);
      }

      html[data-console-theme="light"] .console-account-menu-line {
        color: #5f656c;
      }

      html[data-console-theme="light"] .console-account-menu-muted {
        color: #8a8f96;
      }

      html[data-console-theme="light"] .console-account-menu-separator {
        background: #e5e5de;
      }

      html[data-console-theme="light"] .console-control-tabs {
        border-bottom-color: #deded7;
      }

      html[data-console-theme="light"] .console-control-tab {
        color: #6b7078;
      }

      html[data-console-theme="light"] .console-control-tab:hover {
        color: #24272b;
      }

      html[data-console-theme="light"] .console-control-tab-active {
        border-color: #28a65d;
        color: #168f4a;
      }

      html[data-console-theme="light"] .console-run-row {
        background: #ffffff;
        color: #6f757c;
        box-shadow: inset 0 0 0 1px #deded7;
      }

      html[data-console-theme="light"] .console-run-status {
        color: #303438;
      }

      html[data-console-theme="light"] .console-run-id {
        color: #7a7f86;
      }

      html[data-console-theme="light"] .form-section,
      html[data-console-theme="light"] .console-panel,
      html[data-console-theme="light"] .console-scroll-panel {
        border-color: #deded7;
        background: #ffffff;
      }

      html[data-console-theme="light"] .console-table-head {
        background: #f0f0eb;
        color: #7a7f86;
      }

      html[data-console-theme="light"] .console-table > thead {
        border-block-end-color: #e6e5de;
        border-bottom-color: #e6e5de;
      }

      html[data-console-theme="light"] .role-pill {
        background: #eaf6ff;
        color: #0369a1;
        --tw-ring-color: rgb(14 165 233 / 0.3);
      }

      html[data-console-theme="light"] .form-input {
        border-color: #d2d3cc;
        background: #ffffff;
        color: #24272b;
      }

      html[data-console-theme="light"] .form-input::placeholder,
      html[data-console-theme="light"] .placeholder-zinc-500::placeholder,
      html[data-console-theme="light"] .placeholder-zinc-600::placeholder {
        color: #8c9198;
      }

      html[data-console-theme="light"] .btn-secondary {
        border-color: #d2d3cc;
        color: #5f656c;
      }

      html[data-console-theme="light"] .page-title {
        color: #303438;
      }

      html[data-console-theme="light"] .page-subtitle {
        color: #6f757c;
      }

      /* Toggle chips (filter tabs, HTTP methods): the component's @apply'd
         ink colors compile to raw values, so the utility-class remaps above
         don't reach them -- restyle the component classes directly. */
      html[data-console-theme="light"] .chip {
        border-color: #d2d3cc;
        background: #ffffff;
        color: #5f656c;
      }

      html[data-console-theme="light"] .chip:hover {
        border-color: #168f4a80;
        color: #303438;
      }

      html[data-console-theme="light"] .chip-on,
      html[data-console-theme="light"] .chip-on:hover {
        border-color: #168f4a;
        background: rgba(22, 143, 74, 0.08);
        color: #168f4a;
      }

      html[data-console-theme="light"] .empty-state {
        border-color: #d8d8d0;
        background: #f0f0eb;
        color: #8c9198;
      }

      html[data-console-theme="light"] .console-link,
      html[data-console-theme="light"] .text-centaur-300,
      html[data-console-theme="light"] .text-centaur-400,
      html[data-console-theme="light"] .text-centaur-500 {
        color: #168f4a;
      }

      html[data-console-theme="light"] .bg-ink-950,
      html[data-console-theme="light"] .bg-ink-950\/15,
      html[data-console-theme="light"] .bg-ink-950\/35,
      html[data-console-theme="light"] .bg-ink-950\/80,
      html[data-console-theme="light"] .bg-ink-900,
      html[data-console-theme="light"] .bg-ink-900\/25,
      html[data-console-theme="light"] .bg-ink-900\/35,
      html[data-console-theme="light"] .bg-ink-900\/80 {
        background-color: #f6f6f2;
      }

      html[data-console-theme="light"] .bg-ink-850,
      html[data-console-theme="light"] .bg-ink-850\/40,
      html[data-console-theme="light"] .bg-ink-850\/50,
      html[data-console-theme="light"] .bg-ink-850\/60,
      html[data-console-theme="light"] .bg-ink-850\/70,
      html[data-console-theme="light"] .bg-ink-850\/80,
      html[data-console-theme="light"] .bg-ink-800,
      html[data-console-theme="light"] .bg-ink-800\/60,
      html[data-console-theme="light"] .bg-ink-800\/80,
      html[data-console-theme="light"] .bg-ink-700,
      html[data-console-theme="light"] .bg-ink-700\/60 {
        background-color: #ffffff;
      }

      html[data-console-theme="light"] .bg-ink-600 {
        background-color: #e8e9e3;
      }

      html[data-console-theme="light"] .border-ink-500,
      html[data-console-theme="light"] .border-ink-600,
      html[data-console-theme="light"] .border-ink-600\/80,
      html[data-console-theme="light"] .border-ink-700 {
        border-color: #deded7;
      }

      html[data-console-theme="light"] .ring-ink-500,
      html[data-console-theme="light"] .ring-ink-600 {
        --tw-ring-color: #d8d8d0;
      }

      /* Tailwind v4 puts divide-y borders on `> :not(:last-child)` (border-bottom),
         not on the v3 `~` sibling selector — the first child carries a divider too,
         so the recolor must cover it or the first row's border stays ink-dark. */
      html[data-console-theme="light"] .divide-ink-600 > :not(:last-child),
      html[data-console-theme="light"] .divide-ink-700 > :not(:last-child) {
        border-block-color: #deded7;
        border-color: #deded7;
      }

      html[data-console-theme="light"] .text-zinc-50,
      html[data-console-theme="light"] .text-zinc-100,
      html[data-console-theme="light"] .text-zinc-200,
      html[data-console-theme="light"] .text-zinc-300 {
        color: #303438;
      }

      html[data-console-theme="light"] .text-zinc-400 {
        color: #565c63;
      }

      html[data-console-theme="light"] .text-zinc-500 {
        color: #6f757c;
      }

      html[data-console-theme="light"] .text-zinc-600 {
        color: #8c9198;
      }

      /* The mobile top bar (hamburger + brand) and the drawer scrim are hidden
         on desktop; the media query below turns them on for narrow viewports. */
      .console-mobile-bar {
        display: none;
        flex: 0 0 auto;
        position: sticky;
        top: 0;
        z-index: 30;
        height: 3.25rem;
        align-items: center;
        gap: 0.75rem;
        padding: 0 0.75rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.07);
        background: rgba(7, 7, 8, 0.92);
        backdrop-filter: blur(8px);
      }

      .console-mobile-nav-toggle {
        display: grid;
        height: 2.25rem;
        width: 2.25rem;
        flex: 0 0 auto;
        cursor: pointer;
        place-items: center;
        border-radius: 0.625rem;
        color: #d4d4d8;
        transition: background 120ms ease, color 120ms ease;
      }

      .console-mobile-nav-toggle:hover {
        background: rgba(255, 255, 255, 0.06);
        color: #f4f4f5;
      }

      .console-mobile-brand {
        display: flex;
        min-width: 0;
        align-items: center;
        color: #f4f4f5;
        text-decoration: none;
      }

      .console-mobile-brand img {
        height: 1.4rem;
        width: auto;
      }

      .console-scrim {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 40;
        background: rgba(0, 0, 0, 0.55);
        opacity: 0;
        pointer-events: none;
        transition: opacity 200ms ease;
      }

      html[data-console-theme="light"] .console-mobile-bar {
        border-bottom-color: #deded7;
        background: rgba(251, 251, 248, 0.92);
      }

      html[data-console-theme="light"] .console-mobile-nav-toggle {
        color: #5f656c;
      }

      html[data-console-theme="light"] .console-mobile-nav-toggle:hover {
        background: #edede8;
        color: #24272b;
      }

      html[data-console-theme="light"] .console-mobile-brand {
        color: #24272b;
      }

      html[data-console-theme="light"] .console-mobile-brand img {
        filter: invert(1) drop-shadow(0 0 14px rgba(40, 194, 106, 0.14));
      }

      /* Mobile: the 18rem rail squeezes the content to a sliver, so below this
         breakpoint the sidebar becomes an off-canvas drawer toggled from the
         top bar. The main content then gets the full viewport width, and the
         drawer keeps its full labels/brand/account row (no cryptic icon-only
         rail). */
      @media (max-width: 768px) {
        .console-mobile-bar {
          display: flex;
        }

        .console-sidebar {
          position: fixed;
          top: 0;
          bottom: 0;
          left: 0;
          z-index: 50;
          width: 17rem;
          max-width: 82vw;
          transform: translateX(-100%);
          transition: transform 200ms ease;
        }

        .console-nav-open .console-sidebar {
          transform: translateX(0);
          box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
        }

        .console-scrim {
          display: block;
        }

        .console-nav-open .console-scrim {
          opacity: 1;
          pointer-events: auto;
        }

        .console-main-page {
          padding: 1rem 1rem 1.5rem;
        }

      }
    </style>
  </head>

  <% scheduled_tasks_view = request.path.start_with?("/console/scheduled_tasks") %>
  <% workflows_view = request.path.start_with?("/console/workflows") %>
  <% skills_view = request.path.start_with?("/console/skills") %>
  <%# The Control and Data Sync sections are admin-only (each controller enforces
      require_admin server-side); Integrations is for everyone -- it lists the
      public consent start links any team member can use. %>
  <% nav_items = [] %>
  <% if acting_admin? %>
    <% control_matches = [ "/console/principals", "/console/roles", "/console/secrets", "/console/credentials", "/console/oauth_apps", "/console/users" ] %>
    <% nav_items = [
      { label: "Control", icon: "shield-check", path: console_principals_path, matches: control_matches, root_active: true },
      { label: "Data Sync", icon: "database", path: console_etls_path, matches: [ "/console/etls" ] }
    ] %>
  <% end %>
  <% nav_items << { label: "Integrations", icon: "link", path: console_integrations_path, matches: [ "/console/integrations" ] } %>

  <body class="h-full overflow-hidden bg-ink-900 text-zinc-300 font-mono antialiased <%= "console-descoped" if descoped? %>">
    <% if descoped? %>
      <div class="console-descope-banner" role="status">
        <span>Admin permissions paused — viewing the console as an operator</span>
        <%= button_to "Restore admin", console_descope_path, method: :delete,
              class: "console-descope-restore" %>
      </div>
    <% end %>
    <div id="console-shell" class="console-shell">
      <aside class="console-sidebar" aria-label="Console navigation">
        <div class="console-sidebar-top">
          <a href="<%= root_path %>" class="console-brand" aria-label="Centaur Console">
            <span class="console-brand-glyph">
              <%= image_tag "/icon.svg", alt: "", aria: { hidden: true }, width: 275, height: 275 %>
            </span>
            <span class="console-brand-lockup">
              <%= image_tag "centaur-lockup-white.svg", alt: "Centaur", class: "glow", width: 497, height: 127 %>
            </span>
          </a>
        </div>

        <div class="console-sidebar-scroll">
          <nav class="console-nav-list" aria-label="Console sections">
            <% nav_items.each do |item| %>
              <% active = request.path == item[:path] ||
                          item[:matches].any? { |match| request.path.start_with?(match) } ||
                          (item[:root_active] && request.path == root_path) %>
              <a href="<%= item[:path] %>"
                 class="console-nav-link <%= "console-nav-link-active" if active %>"
                 title="<%= item[:label] %>">
                <span class="console-nav-icon"><%= console_icon(item[:icon], classes: "size-4") %></span>
                <span class="console-nav-label"><%= item[:label] %></span>
              </a>
            <% end %>
          </nav>

          <div class="console-thread-group">
            <a href="<%= console_skills_path %>"
               class="console-thread-group-title <%= "console-thread-group-title-active" if skills_view %>"
               title="Skills">
              <span class="console-nav-icon"><%= console_icon("workflow", classes: "size-4") %></span>
              <span class="console-nav-label">Skills</span>
            </a>
          </div>

          <div class="console-thread-group">
            <a href="<%= console_scheduled_tasks_path %>"
               class="console-thread-group-title <%= "console-thread-group-title-active" if scheduled_tasks_view %>"
               title="Scheduled">
              <span class="console-nav-icon"><%= console_icon("clock", classes: "size-4") %></span>
              <span class="console-nav-label">Scheduled</span>
            </a>
          </div>

          <% if acting_admin? %>
            <div class="console-thread-group">
              <a href="<%= console_workflows_path %>"
                 class="console-thread-group-title <%= "console-thread-group-title-active" if workflows_view %>"
                 title="Workflows">
                <span class="console-nav-icon"><%= console_icon("workflow", classes: "size-4") %></span>
                <span class="console-nav-label">Workflows</span>
              </a>
            </div>
          <% end %>
        </div>

        <% if current_user %>
          <div class="console-sidebar-account" data-account-menu>
            <button type="button"
                    id="console-account-menu-button"
                    class="console-account-button"
                    aria-haspopup="menu"
                    aria-expanded="false"
                    aria-controls="console-account-menu">
              <span class="console-user-avatar"><%= current_user.email.to_s[0].to_s.upcase.presence || "?" %></span>
              <span class="console-account-email console-account-details" title="<%= current_user.email %>"><%= current_user.email %></span>
            </button>
            <div id="console-account-menu"
                 class="console-account-menu"
                 role="menu"
                 aria-labelledby="console-account-menu-button"
                 hidden>
              <div class="console-account-menu-line" title="<%= current_user.email %>"><%= current_user.email %></div>
              <div class="console-account-menu-line console-account-menu-muted">Centaur Console</div>
              <div class="console-account-menu-separator"></div>
              <%# PWA install entry point. Hidden unless the browser reports
                  the console is installable (beforeinstallprompt); installing
                  keeps the standalone window plus the manifest's file_handlers
                  registration. %>
              <button type="button"
                      class="console-account-menu-button"
                      data-controller="pwa-install"
                      data-pwa-install-target="banner"
                      data-action="pwa-install#install"
                      hidden
                      role="menuitem"
                      title="Install Centaur Console as a standalone app"
                      aria-label="Install app">
                <%= console_icon("computer", classes: "size-4") %>
                <span>Install app</span>
              </button>
              <button type="button"
                      class="console-account-menu-button"
                      data-console-theme-toggle
                      role="menuitem"
                      aria-label="Current theme: system. Switch to light mode">
                <span data-console-theme-icon="light" hidden><%= console_icon("sun", classes: "size-4") %></span>
                <span data-console-theme-icon="dark" hidden><%= console_icon("moon", classes: "size-4") %></span>
                <span data-console-theme-icon="system"><%= console_icon("computer", classes: "size-4") %></span>
                <span data-console-theme-label>System mode</span>
              </button>
              <% if acting_admin? %>
                <%= button_to console_descope_path,
                      method: :post,
                      class: "console-signout-button",
                      form: { class: "console-signout-form" },
                      role: "menuitem",
                      title: "Temporarily pause your admin permissions",
                      aria: { label: "View as operator" } do %>
                  <%= console_icon("user-circle", classes: "size-4") %>
                  <span class="console-signout-label">View as operator</span>
                <% end %>
              <% end %>
              <%= button_to logout_path,
                    method: :delete,
                    class: "console-signout-button",
                    form: { class: "console-signout-form" },
                    role: "menuitem",
                    title: "Sign out",
                    aria: { label: "Sign out" } do %>
                <%= console_icon("log-out", classes: "size-4") %>
                <span class="console-signout-label">Sign out</span>
              <% end %>
            </div>
          </div>
        <% end %>
      </aside>

      <main class="console-main">
        <div class="console-mobile-bar">
          <button type="button"
                  id="console-mobile-nav-toggle"
                  class="console-mobile-nav-toggle"
                  aria-label="Open navigation"
                  aria-controls="console-shell"
                  aria-expanded="false"
                  data-console-nav-toggle>
            <%= console_icon("menu", classes: "size-5") %>
          </button>
          <a href="<%= root_path %>" class="console-mobile-brand" aria-label="Centaur Console">
            <%= image_tag "centaur-lockup-white.svg", alt: "Centaur", class: "glow", width: 497, height: 127 %>
          </a>
        </div>
        <div class="console-main-page">
          <% if flash[:notice] %>
            <div class="mb-6 rounded border border-ink-600 bg-ink-850/60 px-4 py-3 text-sm text-zinc-400"><%= flash[:notice] %></div>
          <% end %>
          <% if flash[:alert] %>
            <div class="alert-error"><%= flash[:alert] %></div>
          <% end %>
          <%= yield %>
        </div>
      </main>

      <div class="console-scrim" data-console-nav-scrim aria-hidden="true"></div>
    </div>

    <script>
      (() => {
        // Mobile navigation drawer. Below the CSS breakpoint the sidebar is
        // off-canvas; the hamburger in the top bar toggles a `console-nav-open`
        // class on the shell that slides it in over a scrim. The drawer closes
        // on scrim click, Escape, following any nav link, and after every Turbo
        // navigation so it never lingers over the freshly loaded page.
        const shell = document.getElementById("console-shell");
        const toggle = document.querySelector("[data-console-nav-toggle]");
        const scrim = document.querySelector("[data-console-nav-scrim]");
        const sidebar = shell && shell.querySelector(".console-sidebar");
        if (!shell || !toggle || !sidebar) return;

        const OPEN_CLASS = "console-nav-open";
        // Mirrors the CSS breakpoint: only in the off-canvas range does a
        // closed drawer need to be pulled out of the tab / assistive-tech order.
        const mobileQuery = window.matchMedia("(max-width: 768px)");

        const isOpen = () => shell.classList.contains(OPEN_CLASS);

        // Off-canvas and closed => hide the sidebar from keyboard and assistive
        // tech: it sits before the page in DOM order, so leaving it merely
        // translated off-screen makes users tab through invisible controls
        // first. Desktop and the open drawer stay fully interactive.
        const syncInert = () => {
          sidebar.inert = mobileQuery.matches && !isOpen();
        };

        const setOpen = (open) => {
          shell.classList.toggle(OPEN_CLASS, open);
          toggle.setAttribute("aria-expanded", String(open));
          syncInert();
        };

        toggle.addEventListener("click", () => setOpen(!isOpen()));
        if (scrim) scrim.addEventListener("click", () => setOpen(false));

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && isOpen()) setOpen(false);
        });

        // Only real navigations should dismiss the drawer. Links (section nav
        // and the brand) qualify; in-drawer buttons that open a menu
        // or reveal more rows (account menu, theme toggle, "show more") must
        // not, or they'd slam the drawer shut before doing anything. Form
        // buttons that submit (sign out, view as operator) trigger a full
        // navigation, which the turbo listeners below already close on.
        shell.addEventListener("click", (event) => {
          if (!isOpen()) return;
          if (event.target.closest(".console-sidebar a[href]")) {
            setOpen(false);
          }
        });

        mobileQuery.addEventListener("change", syncInert);
        document.addEventListener("turbo:visit", () => setOpen(false));
        document.addEventListener("turbo:load", () => setOpen(false));

        syncInert();
      })();

      (() => {
        const accountButton = document.getElementById("console-account-menu-button");
        const accountMenu = document.getElementById("console-account-menu");
        if (!accountButton || !accountMenu) return;

        const closeAccountMenu = () => {
          accountMenu.hidden = true;
          accountButton.setAttribute("aria-expanded", "false");
        };

        accountButton.addEventListener("click", () => {
          const expanded = accountButton.getAttribute("aria-expanded") === "true";
          accountMenu.hidden = expanded;
          accountButton.setAttribute("aria-expanded", String(!expanded));
        });

        document.addEventListener("click", (event) => {
          if (accountMenu.hidden) return;
          if (accountButton.contains(event.target) || accountMenu.contains(event.target)) return;
          closeAccountMenu();
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") closeAccountMenu();
        });
      })();

      (() => {
        const themeToggle = document.querySelector("[data-console-theme-toggle]");
        if (!themeToggle) return;

        const root = document.documentElement;
        const label = themeToggle.querySelector("[data-console-theme-label]");
        const lightIcon = themeToggle.querySelector("[data-console-theme-icon='light']");
        const darkIcon = themeToggle.querySelector("[data-console-theme-icon='dark']");
        const systemIcon = themeToggle.querySelector("[data-console-theme-icon='system']");
        const themePreferences = ["system", "light", "dark"];
        const themeLabels = {
          system: "System mode",
          light: "Light mode",
          dark: "Dark mode"
        };

        const nextThemePreference = (preference) => {
          const currentIndex = themePreferences.indexOf(preference);
          return themePreferences[(currentIndex + 1) % themePreferences.length];
        };

        const syncThemeControl = (preference) => {
          const nextPreference = nextThemePreference(preference);
          if (label) label.textContent = themeLabels[preference];
          themeToggle.setAttribute(
            "aria-label",
            `Current theme: ${preference}. Switch to ${nextPreference} mode`
          );
          themeToggle.dataset.consoleThemePreference = preference;
          if (lightIcon) lightIcon.hidden = preference !== "light";
          if (darkIcon) darkIcon.hidden = preference !== "dark";
          if (systemIcon) systemIcon.hidden = preference !== "system";
        };

        const applyTheme = (preference, persist = false) => {
          if (window.ConsoleTheme) {
            if (persist) window.ConsoleTheme.persist(preference);
            else window.ConsoleTheme.apply(preference);
          } else {
            const useLightTheme = preference === "light" ||
              (preference === "system" && window.matchMedia?.("(prefers-color-scheme: light)").matches);
            const nextTheme = useLightTheme ? "light" : "dark";
            root.dataset.consoleTheme = nextTheme;
          }
          syncThemeControl(preference);
        };

        applyTheme(window.ConsoleTheme?.preference?.() || root.dataset.consoleTheme || "dark");
        themeToggle.addEventListener("click", () => {
          const currentPreference = themeToggle.dataset.consoleThemePreference || "system";
          applyTheme(nextThemePreference(currentPreference), true);
        });
      })();

    </script>
  </body>
</html>
